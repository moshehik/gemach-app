generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/local-client"
}

datasource db {
  provider = "sqlite"
  // Was hardcoded to "file:./gemach-local.db" - switched to env() so it's consistent
  // with every other datasource in this app (all read their URL from .env) and so the
  // local db file path can be overridden per-machine without editing the schema.
  url      = env("SQLITE_URL")
}

model Customer {
