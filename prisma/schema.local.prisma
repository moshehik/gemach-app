  city             String? // ׳¢׳™׳¨
  street           String? // ׳¨׳—׳•׳‘
  houseNum         Int? // ׳‘׳™׳×
  email            String? // ׳׳™׳™׳
  emailSuffix      String? // ׳¡׳™׳•׳׳×_׳׳™׳™׳
  notes            String? // ׳”׳¢׳¨׳•׳×
  registrationDate String? // ׳×׳׳¨׳™׳_׳¨׳™׳©׳•׳
  officeNotes      String? // ׳ ׳×׳•׳ ׳™_׳׳©׳¨׳“
  isDeleted        Boolean   @default(false) // ׳׳§׳•׳—_׳׳—׳•׳§
  isBlocked        Boolean   @default(false) // ׳—׳¡׳•׳ ׳׳”׳–׳׳ ׳•׳× ׳—׳“׳©׳•׳×
  blockedReason    String? // ׳¡׳™׳‘׳× ׳”׳—׳¡׳™׳׳”
  
  // Bank details for refunds
  bankName         String? // ׳©׳ ׳‘׳ ׳§
  bankBranch       String? // ׳¡׳ ׳™׳£
  bankAccount      String? // ׳—׳©׳‘׳•׳
  bankAccountName  String? // ׳©׳ ׳‘׳¢׳ ׳—׳©׳‘׳•׳

  orders           Order[]
