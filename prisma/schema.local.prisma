// Kept in sync with prisma/schema.prisma manually (this repo has no schema-diff CI check).
// @db.Text is a Postgres-only attribute and is intentionally omitted here - SQLite has no
// column-size distinction, TEXT already stores unlimited-length strings.
model ErrorReport {
  id                 String    @id @default(uuid())
  employeeId         String?
  employee           Employee? @relation("EmployeeToErrorReport", fields: [employeeId], references: [id])
  time               String?
  url                String?
  title              String?
  queryParams        String?
  lastButtons        String?
  userText           String
  status             String    @default("OPEN")
  isReadByUser       Boolean   @default(true)
  isReadByProgrammer Boolean   @default(false)
  isHandled          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  replies ErrorReportReply[]
}

model ErrorReportReply {
  id            String      @id @default(uuid())
  errorReportId String
  errorReport   ErrorReport @relation(fields: [errorReportId], references: [id], onDelete: Cascade)
  employeeId    String?
  employee      Employee?   @relation("EmployeeToErrorReportReply", fields: [employeeId], references: [id])
  isProgrammer  Boolean     @default(false)
  text          String
  createdAt     DateTime    @default(now())
}




