  houseNum         Int?       // ׳‘׳™׳×
  email            String?    // ׳׳™׳™׳
  emailSuffix      String?    // ׳¡׳™׳•׳׳×_׳׳™׳™׳
  notes            String?    // ׳”׳¢׳¨׳•׳×
