  finalPrice  Float?     // ׳׳—׳™׳¨ ׳¡׳•׳₪׳™
  
  // Rental/Return lifecycle fields (׳׳™׳’׳¨׳¦׳™׳” ׳׳׳§׳¡׳¡)
  barcode        String?   // ׳‘׳¨׳§׳•׳“ - the scanned barcode assigned at rental
