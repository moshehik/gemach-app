model AuditLog {
  id          Int       @id @default(autoincrement())
  entityType  String    // "Customer", "Order", etc.
  entityId    Int       // The ID of the changed entity
  action      String    // "UPDATE", "CREATE", "DELETE"
  changesJson String    // JSON: {"phone1": {"from":"old","to":"new"}}
  createdAt   DateTime  @default(now())
  employeeId  Int?      // Optional: who made the change

  @@index([entityType, entityId])
  @@index([employeeId])
}


