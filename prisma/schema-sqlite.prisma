  alterationDetails String? // ׳₪׳™׳¨׳•׳˜_׳×׳™׳§׳•׳
  alterationDone   Boolean @default(false) // ׳‘׳•׳¦׳¢_׳×׳™׳§׳•׳

  @@index([orderId])
