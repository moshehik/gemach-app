generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id               String  @id @default(uuid())
  legacyId         Int?    @unique
  firstName        String? // שם_פרטי
  lastName         String? // שם_משפחה
  phone1           String? // טלפון_1
  phone2           String? // טלפון_2
  city             String? // עיר
  street           String? // רחוב
  houseNum         Int? // בית
  email            String? // מייל
  emailSuffix      String? // סיומת_מייל
  notes            String? // הערות
  registrationDate String? // תאריך_רישום
  officeNotes      String? // נתוני_משרד
  isDeleted        Boolean @default(false) // לקוח_מחוק

  // Bank details for refunds
  bankName        String? // שם בנק
  bankBranch      String? // סניף
  bankAccount     String? // חשבון
  bankAccountName String? // שם בעל חשבון

  orders    Order[]
  payments  Payment[]
  refunds   Refund[]
  updatedAt DateTime  @updatedAt

  @@index([phone1])
  @@index([phone2])
  @@index([firstName, lastName])
  @@index([isDeleted])
}

model AuditLog {
  id          String   @id @default(uuid())
  legacyId    Int?     @unique
  entityType  String // "Customer", "Order", etc.
  entityId    String // The ID of the changed entity
  action      String // "UPDATE", "CREATE", "DELETE"
  changesJson String // JSON: {"phone1": {"from":"old","to":"new"}}
  createdAt   DateTime @default(now())
  employeeId  String? // Optional: who made the change
  updatedAt   DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([employeeId])
}

model Employee {
  id                 String         @id @default(uuid())
  legacyId           Int?           @unique
  firstName          String? // שם_פרטי
  lastName           String? // שם_משפחה
  phone1             String? // טלפון_1
  phone2             String? // טלפון_2
  city               String? // עיר
  street             String? // רחוב
  houseNum           String? // בית
  email              String? // מייל
  joinDate           DateTime? // תאריך_כניסה_לארגון
  fullName           String? // שם_מלא
  notes              String? // הערות
  emailSuffix        String? // סיומת_מייל
  roleId             Int? // מס_מחלקה
  password           String? // סיסמא - bcrypt hash (one-way). Historically stored plaintext; migrated in place, see scripts/migrate_hash_passwords.js
  pinHash            String? // bcrypt hash of the last 4 characters of the real password - only usable together with a valid TrustedDevice cookie, never on its own
  mustResetPassword  Boolean        @default(false) // true right after a forgot-password temp password is issued; forces a real password change on next successful login
  isActive           Boolean        @default(true) // לא_פעיל
  hourlyWage         Float? // שכר_שעה
  paymentMethod      String? // אופן_תשלום
  travelExpenses     Boolean?       @default(false) // נסיעות
  themeColor         String?        @default("standard") // פלטת גוונים
  profileImage       String? // קובץ פלוס תמונה
  receiveEmailAlerts Boolean        @default(false) // קבלת התראות למייל
  showAi             Boolean        @default(false) // הרשאת AI
  pageVisits         PageVisitLog[]

  shifts Shift[]

  department Department? @relation(fields: [roleId], references: [roleId])

  sentNotifications     Notification[]     @relation("SentNotifications")
  receivedNotifications Notification[]     @relation("ReceivedNotifications")
  Order                 Order[]
  AIChatSession         AIChatSession[]
  errorReports          ErrorReport[]      @relation("EmployeeToErrorReport")
  errorReportReplies    ErrorReportReply[] @relation("EmployeeToErrorReportReply")
  updatedAt             DateTime           @updatedAt

  @@index([phone1])
  @@index([fullName])
}

// A shared physical computer at the gemach that a manager has explicitly marked as
// trusted, letting whoever is logged into that browser log in with just the last 4
// digits of their real password (see lib/passwordAuth.js / lib/trustedDevice.js).
// The trust boundary is this row + the random token in the httpOnly cookie, NOT the
// 4-digit PIN itself - the PIN alone (without the matching cookie) authenticates no one.
model TrustedDevice {
  id          String    @id @default(uuid())
  tokenHash   String    @unique // sha256 of the random token stored in the trusted_device cookie - only the hash is persisted
  label       String? // optional manager-given name, e.g. "עמדה קדמית"
  createdById String? // Employee.id of the manager who marked this computer trusted
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime? // soft-revoke: keeps history instead of deleting the row

  @@index([revokedAt])
}

model Notification {
  id         String            @id @default(uuid())
  legacyId   Int?              @unique
  senderId   String? // מזהה השולח
  sender     Employee?         @relation("SentNotifications", fields: [senderId], references: [id])
  receiverId String? // מזהה המקבל. אם null, ההודעה נשלחת לכולם
  receiver   Employee?         @relation("ReceivedNotifications", fields: [receiverId], references: [id])
  title      String? // כותרת ההודעה
  content    String // תוכן ההודעה
  createdAt  DateTime          @default(now()) // תאריך יצירה
  isRead     Boolean           @default(false) // להודעות אישיות - האם נקרא
  readBy     String            @default("[]") // להודעות אישיות - האם נקרא
  isArchived Boolean           @default(false) // להודעות אישיות - האם בארכיון
  archivedBy String            @default("[]") // להודעות כלליות - עובדים שהעבירו לארכיון
  tags       NotificationTag[]
  updatedAt  DateTime          @updatedAt

  @@index([receiverId])
  @@index([senderId])
}

model Shift {
  id         String    @id @default(uuid())
  legacyId   Int?      @unique
  employeeId String // קוד_עובד
  employee   Employee  @relation(fields: [employeeId], references: [id])
  entryTime  DateTime? // שעת_כניסה
  exitTime   DateTime? // שעת_יציאה
  hebrewDate String? // תאריך_עברי

  date                   DateTime? // תאריך המשמרת (ללא שעה) - Computed or mapped
  totalMinutes           Int? // סה"כ דקות מחושב
  hourlyWageSnapshot     Float? // שכר שעה רלוונטי לאותה משמרת
  travelExpensesSnapshot Float? // נסיעות לאותה משמרת
  totalCalculated        Float? // סה"כ לתשלום מחושב עבור המשמרת
  paymentMethod          String? // אופן תשלום רצוי או בוצע
  notes                  String? // תקלות / הערות
  isDeleted              Boolean   @default(false) // מחיקה רכה
  updatedAt              DateTime  @updatedAt

  @@index([employeeId])
  @@index([date])
  @@index([isDeleted])
}

model DressModel {
  id               String      @id @default(uuid())
  legacyId         Int?        @unique
  name             String?     @unique // שם_שמלה
  barcodePrefix    Int? // בר_קוד_קידומת
  priceCategory    String? // קטגורית_מחיר
  notes            String? // הערות
  inInspection     Boolean     @default(false) // הצג_בבדיקה
  imageUrl         String? // נתיב לתמונה
  entryDateToRepo  DateTime? // תאריך_כניסה_למאגר
  exitDateFromRepo DateTime? // תאריך_יציאה_מהמאגר
  inactiveReason   String? // סיבת לא פעיל
  isDeleted        Boolean     @default(false) // מחוק
  deletedAt        DateTime? // תאריך_מחיקה
  items            DressItem[]
  updatedAt        DateTime    @updatedAt

  @@index([priceCategory])
  @@index([isDeleted])
}

model DressItem {
  id              String      @id @default(uuid())
  legacyId        Int?        @unique
  barcodePrefix   Int? // בר_קוד_קידומת
  dressModelId    String? // קשר לדגם
  dress           DressModel? @relation(fields: [dressModelId], references: [id], onUpdate: Cascade)
  dressName       String? // שם_שמלה (Legacy, pre-migration)
  sizeText        String? // מידה_טקסט
  serialNumber    Int? // מספר_סידורי
  dressBarcode    String? // בר_קוד_שמלה
  location        String? // מיקום
  locationNum     Int? // מיקום_מס
  quantity        Int?        @default(1) // כמות
  inRepair        Boolean     @default(false) // שמלה_בתיקון
  notInUse        Boolean     @default(false) // לא_בשימוש
  notInUseSince   DateTime? // לא_בשימוש_מתאריך
  entryDateToRepo DateTime? // תאריך_כניסה_למאגר
  isDeleted       Boolean     @default(false) // מחוק
  deletedAt       DateTime? // תאריך_מחיקה
  orderItems      OrderItem[]
  updatedAt       DateTime    @updatedAt

  @@index([dressModelId])
  @@index([dressBarcode])
  @@index([barcodePrefix])
  @@index([isDeleted])
  @@index([notInUse])
  @@index([inRepair])
}

model Order {
  id                   String    @id @default(uuid())
  legacyId             Int?      @unique
  orderId              Int       @unique // קוד_הזמנה
  customerId           String? // Extracted manually if possible
  customer             Customer? @relation(fields: [customerId], references: [id])
  totalAmount          Float? // סכום
  paymentDate          DateTime? // תאריך_תשלום
  paymentMethod        String? // צורת_תשלום
  status               String? // סטטוס נגזר מהתשלום
  notes                String? // הערות
  isPaid               Boolean   @default(false) // שולם
  isDeleted            Boolean   @default(false) // מחוק - הזמנה מבוטלת
  orderNotes           String? // הערות_להזמנה
  hasSignedRegulations Boolean   @default(false) // חתמו על התקנון

  // New fields from Access
  eventDate       DateTime? // תאריך אירוע לועזי
  eventDateHebrew String? // תאריך אירוע עברי
  returnDate      DateTime? // עד תאריך (תאריך החזרה)
  orderDate       DateTime? // תאריך הזמנה

  employeeId String? // קוד_עובד
  employee   Employee? @relation(fields: [employeeId], references: [id])
  deletedAt  DateTime? // תאריך_מחיקה

  // Custom occupancy fields (abroad/long term)
  isAbroad       Boolean   @default(false) // אירוע חו"ל
  isWeekdayEvent Boolean   @default(false) // אירוע חול
  fromDate       DateTime? // מתאריך
  toDate         DateTime? // עד תאריך

  customSpacing Int? // ציפוף ימים מותאם אישית להזמנה זו

  items       OrderItem[]
  payments    Payment[]
  refunds     Refund[]
  obligations PaymentObligation[]
  updatedAt   DateTime            @updatedAt

  @@index([customerId])
  @@index([paymentDate])
  @@index([eventDate])
  @@index([orderDate])
  @@index([isDeleted])
  @@index([status])
}

model Payment {
  id            String    @id @default(uuid())
  legacyId      Int?      @unique
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  orderId       Int?
  order         Order?    @relation(fields: [orderId], references: [orderId])
  amount        Float // סכום התשלום
  paymentDate   DateTime  @default(now()) // תאריך תשלום
  paymentMethod String? // אמצעי תשלום
  notes         String? // הערות
  isDeleted     Boolean   @default(false) // נמחק
  isRefund      Boolean   @default(false) // האם זה תשלום הפכי (זיכוי)
  updatedAt     DateTime  @updatedAt

  refunds Refund[]

  @@index([customerId])
  @@index([orderId])
  @@index([isDeleted])
  @@index([paymentDate])
}

model PaymentObligation {
  id          String   @id @default(uuid())
  legacyId    Int?     @unique
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  productId   String? // קוד_מוצר מהמחירון
  amount      Float // סכום לחיוב (מחיר * כמות)
  quantity    Int      @default(1)
  description String? // תיאור
  createdAt   DateTime @default(now())
  isDeleted   Boolean  @default(false) // נמחק
  isRefund    Boolean  @default(false) // זיכוי
  isManual    Boolean  @default(true) // האם הוזן ידנית

  orderItemId String? // קוד_פריט
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  updatedAt   DateTime   @updatedAt

  @@index([orderId])
  @@index([orderItemId])
  @@index([isDeleted])
  @@index([productId])
}

model OrderItem {
  id          String              @id @default(uuid())
  legacyId    Int?                @unique
  orderId     Int? // קוד_הזמנה (relates to Order.orderId)
  order       Order?              @relation(fields: [orderId], references: [orderId])
  dressItemId String? // קישור לשמלה
  obligations PaymentObligation[]
  dressItem   DressItem?          @relation(fields: [dressItemId], references: [id])
  price       Float? // מחיר (final price used historically)
  quantity    Int?                @default(1) // כמות - תמיד 1
  description String? // תיאור

  // New fields from Access
  sizeText   String? // מידה_טקסט - the size selected
  repairs    String? // פירוט תיקונים
  basePrice  Float? // מחיר בסיס (לפני תיקונים)
  finalPrice Float? // מחיר סופי

  // Rental/Return lifecycle fields (מיגרציה מאקסס)
  barcode       String? // ברקוד - the scanned barcode assigned at rental
  barcodePrefix Int? // בר_קוד_קידומת - prefix portion of barcode
  size          String? // מידה - numeric size from barcode
  isTaken       Boolean   @default(false) // נלקח - was the item physically taken
  isReturned    Boolean   @default(false) // הוחזר - was the item returned
  returnedOk    Boolean   @default(false) // חזר_תקין - returned in good condition
  takenDate     DateTime? // תאריך_לקיחה
  returnDate    DateTime? // תאריך_החזרה
  orderDate     DateTime? // תאריך_הזמנה
  isDeleted     Boolean   @default(false) // מחוק - soft delete
  deletedAt     DateTime? // תאריך_מחיקה

  cartStatus     String   @default("pending") // "pending" or "confirmed"
  cartStatusDate DateTime @default(now()) // תאריך תחילת סטטוס

  // Alteration tracking (תיקונים)
  neckAlteration    Int?     @default(0) // תיקון_צוואר
  lengthAlteration  String? // תיקון_אורך
  sleeveAlteration  Int?     @default(0) // תיקון_שרוול
  alterationDetails String? // פירוט_תיקון
  alterationDone    Boolean  @default(false) // בוצע_תיקון
  createdAt         DateTime @default(now()) // תאריך יצירה למיון מהיר
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([dressItemId])
  @@index([barcode])
  @@index([isDeleted])
  @@index([createdAt])
  @@index([isTaken])
  @@index([isReturned])
}

model PriceList {
  id          String    @id @default(uuid())
  legacyId    Int?      @unique
  description String? // תיאור
  fromSize    Int? // ממידה
  toSize      Int? // עד_מידה
  price       Float? // מחיר
  startDate   DateTime? // תאריך_התחלת_מחיר
  endDate     DateTime? // תאריך_סיום_מחיר
  category    String? // קטגוריה (links to DressModel.priceCategory)
  deposit     Float? // החזר
  updatedAt   DateTime  @updatedAt
}

model SystemSetting {
  id        String   @id @default(uuid())
  legacyId  Int?     @unique
  key       String   @unique // מפתח הגדרה
  value     String? // ערך
  name      String? // שם תצוגה
  category  String? // קטגוריה
  notes     String? // הערות
  type      String   @default("text") // סוג הפקד בממשק
  updatedAt DateTime @updatedAt
}

model PriceRule {
  id          String    @id @default(uuid())
  legacyId    Int?      @unique
  description String? // תיאור
  minSize     Int? // ממידה
  maxSize     Int? // עד_מידה
  price       Float? // מחיר
  startDate   DateTime? // תאריך_התחלת_מחיר
  endDate     DateTime? // תאריך_סיום_מחיר
  category    String? // קטגוריה
  refund      Float? // החזר
  updatedAt   DateTime  @updatedAt
}

model PageVisitLog {
  id            String    @id @default(uuid())
  legacyId      Int?      @unique
  pageUrl       String // The path visited
  employeeId    String? // Nullable, relates to Employee if logged in
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName  String? // Name of the employee or "אורח"
  timestamp     DateTime  @default(now()) // Exact time of visit
  loadingError  String? // Details of any error that occurred
  isGuest       Boolean   @default(false)
  requestQuery  String? // השאילתה/פרמטרים שנשלחו ל-API
  responseSize  Int? // כמות המידע שהוחזר בבתים (Bytes)
  executionTime Int? // משך ביצוע השאילתה במאיות שנייה
  updatedAt     DateTime  @updatedAt

  @@index([employeeId])
  @@index([timestamp])
}

model EmailLog {
  id           String   @id @default(uuid())
  legacyId     Int?     @unique
  to           String
  cc           String?
  subject      String?
  body         String?
  fileName     String?
  status       String
  errorMessage String?
  customerId   String?
  employeeId   String?
  sentAt       DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@index([employeeId])
}

model QueryLog {
  id         String   @id @default(uuid())
  legacyId   Int?     @unique
  query      String // The actual SQL query executed
  executedAt DateTime @default(now())
  success    Boolean // Whether it succeeded or failed
  errorMsg   String? // The error message if failed
  employeeId String? // Who executed it (if known)
  updatedAt  DateTime @updatedAt

  @@index([executedAt])
  @@index([employeeId])
}

model NotificationTag {
  id             String       @id @default(uuid())
  legacyId       Int?         @unique
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  employeeId     String // העובד שהוסיף את התגית
  tag            String // שם התגית
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([notificationId, employeeId, tag])
  @@index([employeeId])
  @@index([notificationId])
}

model Department {
  id       String @id @default(uuid())
  legacyId Int?   @unique
  roleId   Int    @unique // מס_מחלקה
  name     String // שם_מחלקה

  employees Employee[]
}

model AIChatSession {
  id           String    @id @default(uuid())
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id])
  context      String    @default("כללי") // e.g. "Home", "Customers", "Employees", "Manager"
  messagesJson String    @db.Text // Store full chat as JSON
  startedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId])
  @@index([startedAt])
}

model Refund {
  id              String   @id @default(uuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  orderId         Int?
  order           Order?   @relation(fields: [orderId], references: [orderId])
  amount          Float
  reason          String? // הערות: על מה
  bankName        String? // שם בנק
  bankBranch      String? // סניף
  bankAccount     String? // חשבון
  bankAccountName String? // שם בעל חשבון
  paymentDetails  String? // פרטי תשלומים ו4 ספרות אחרונות
  email           String? // מייל

  isExecuted    Boolean   @default(false) // בוצע החזר
  executionDate DateTime? // תאריך ביצוע
  executedBy    String? // קוד עובד שביצע

  paymentId String? // מזהה התשלום ההפכי שנוצר
  payment   Payment? @relation(fields: [paymentId], references: [id])

  isAutoGenerated Boolean @default(false) // נוצר אוטומטית ממעקב יתרת זכות (syncPendingCreditRefund), לא ע"י עובד

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@index([isExecuted])
  @@index([isDeleted])
}

model ErrorReport {
  id                 String    @id @default(uuid())
  employeeId         String?
  employee           Employee? @relation("EmployeeToErrorReport", fields: [employeeId], references: [id])
  time               String?
  url                String?
  title              String?
  queryParams        String?
  lastButtons        String?   @db.Text
  userText           String    @db.Text
  status             String    @default("OPEN")
  isReadByUser       Boolean   @default(true)
  isReadByProgrammer Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  replies ErrorReportReply[]
}

model ErrorReportReply {
  id            String      @id @default(uuid())
  errorReportId String
  errorReport   ErrorReport @relation(fields: [errorReportId], references: [id], onDelete: Cascade)
  employeeId    String?
  employee      Employee?   @relation("EmployeeToErrorReportReply", fields: [employeeId], references: [id])
  isProgrammer  Boolean     @default(false)
  text          String      @db.Text
  createdAt     DateTime    @default(now())
}
